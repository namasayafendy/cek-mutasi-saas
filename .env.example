NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Phase 6: site URL untuk redirect link invite & password reset email
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Phase 8: comma-separated list email yang punya akses /superadmin
SUPERADMIN_EMAILS=namasayafendy@gmail.com
# Phase 8: harga subscription bulanan (Rp) untuk hitung MRR — sementara hardcode
SUBSCRIPTION_PRICE_RP=50000
# Phase 8.6: hCaptcha site key (public). Daftar di https://www.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-site-key-here

# ── Integrasi internal (AI Hub) — sudah dipakai /api/internal/daily-inbound ──
# Secret server-to-server. Dipakai juga sebagai kunci admin /api/tg/set-webhook.
AI_HUB_INTERNAL_SECRET=isi-dengan-secret-panjang-acak
# Akun yang dikunci untuk endpoint internal + kanal mutasi Telegram.
# account_id TIDAK PERNAH diterima dari request — mencegah akses lintas-tenant
# walaupun secret-nya bocor.
CEKMUTASI_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# ── Kanal masuk mutasi lewat Telegram (Fase 1) ──
# Token bot laporan pemilik. NILAINYA SAMA dengan yang dipakai aplikasi gadai
# untuk mengirim alert; di sini bot yang sama juga MENERIMA berkas.
TG_MUTASI_BOT_TOKEN=123456:ABC-DEF...
# Chat PRIBADI pemilik. Webhook menolak chat lain dan menolak grup.
TG_MUTASI_CHAT_ID=7840500590
# Rahasia webhook: dikirim Telegram di header X-Telegram-Bot-Api-Secret-Token.
# FAIL-CLOSED — kalau kosong, webhook menolak SEMUA kiriman.
TG_WEBHOOK_SECRET=isi-dengan-secret-panjang-acak
# Kunci admin untuk /api/tg/set-webhook (memasang & MENCOPOT webhook).
# Opsional: kalau kosong, dipakai AI_HUB_INTERNAL_SECRET. Sebaiknya diisi
# terpisah supaya bocornya rahasia AI Hub tidak berarti kendali atas kanal ini.
TG_ADMIN_SECRET=isi-dengan-secret-panjang-acak
